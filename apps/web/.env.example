# Copy to .env (apps/web/.env) if you need to override defaults.

# Base URL of the API server (apps/api). Defaults to http://127.0.0.1:3001
# in src/lib/api.ts if not set. If the API runs on another port (e.g. 3001
# is taken by another app), set it here:
# VITE_API_URL=http://127.0.0.1:3002
VITE_API_URL=
