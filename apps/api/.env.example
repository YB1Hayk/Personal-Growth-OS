# Copy this file to .env in this same directory (apps/api/.env) and fill in real values.
# apps/api/src/shared/lib/config.ts loads apps/api/.env via dotenv.

# Port the Express server listens on
PORT=3001

# Prisma datasource. SQLite for local/single-user use, e.g.:
# DATABASE_URL="file:./dev.db""file:./prisma/dev.db"
DATABASE_URL="file:./dev.db"

# OpenAI API key, used only if AI_PROVIDER=openai (legacy direct OpenAI provider)
OPENAI_API_KEY=

# Telegram bot token used by the telegram module for publishing/DMs
TELEGRAM_BOT_TOKEN=

# --- AI provider (apps/api/src/shared/ai) ---

# Which AIProvider implementation to use: "openrouter" (default) or "openai"
AI_PROVIDER=openrouter

# OpenRouter (https://openrouter.ai) — single access point to many models,
# OpenAI-compatible API at https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# Model string as listed on https://openrouter.ai/models, e.g.
# "deepseek/deepseek-chat" (cheap default) or "anthropic/claude-sonnet-4.5"
OPENROUTER_MODEL=deepseek/deepseek-chat

# S2S postback authentication. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Partner must send x-postback-token header and unique eventid query parameter.
POSTBACK_TOKEN=
